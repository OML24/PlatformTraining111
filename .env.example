# انسخ هذا الملف إلى .env ثم بدّل القيم السرية قبل التشغيل.
POSTGRES_DB=zu_training
POSTGRES_USER=zu_training
POSTGRES_PASSWORD=change-me-strong-db-password

# مفتاح تشفير بيانات الاعتماد (Base64، 32 بايت) — ولّده بالأمر:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-32-bytes
# مفتاح توقيع رموز الجلسة (32 حرفاً أو أكثر)
JWT_SIGNING_KEY=replace-with-a-long-random-secret

# العنوان العام الذي يفتحه المستخدمون (خلف nginx أو مباشرة)
PUBLIC_ORIGIN=http://localhost:8080
PORTAL_PORT=8080

SESSION_HOURS=8
REMEMBER_DAYS=30
CERTIFICATE_FONT=Noto Naskh Arabic

# خادم البريد (اختياري للمرحلة الأولى)
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=منصة التدريب والتطوير المهني — جامعة الزرقاء
