# ملف البيئة المشترك لخدمتي الـAPI والبوابة على Ubuntu.
# يُنسخ إلى /etc/zu-training/zu-training.env ويُقيّد بـ chmod 600.
ASPNETCORE_ENVIRONMENT=Production

# قاعدة البيانات (PostgreSQL محلي)
ConnectionStrings__TrainingDb=Host=127.0.0.1;Port=5432;Database=zu_training;Username=zu_training;Password=CHANGE_ME

# مفاتيح الأمان — ولّدها مرة واحدة واحتفظ بها
Security__EncryptionKey=CHANGE_ME_BASE64_32_BYTES
Security__JwtSigningKey=CHANGE_ME_LONG_RANDOM
Security__SessionHours=8
Security__RememberDays=30

# العنوان العام
Portal__BaseUrl=https://training.zu.edu.jo
WebPortal__Origin=https://training.zu.edu.jo
Certificate__VerificationBaseUrl=https://training.zu.edu.jo/verify.html
Certificate__FontFamily=Noto Naskh Arabic

# مسارات التخزين
Storage__OfficialDocumentsPath=/var/lib/zu-training/storage/official-documents
Storage__CertificateTemplatesPath=/var/lib/zu-training/storage/certificate-templates
Storage__CertificatesPath=/var/lib/zu-training/storage/certificates
Storage__CourseFilesPath=/var/lib/zu-training/storage/course-files

# بيانات الجامعة
University__Employees=https://eservices.zu.edu.jo/ords/fees/qa/employees
University__Departments=https://eservices.zu.edu.jo/ords/fees/qa/departments
University__Faculties=https://eservices.zu.edu.jo/ords/fees/qa/faculties

# البريد
Email__Host=
Email__Port=587
Email__EnableSsl=true
Email__UserName=
Email__Password=
Email__FromAddress=
Email__FromName=منصة التدريب والتطوير المهني — جامعة الزرقاء

# عنوان الـAPI الداخلي الذي تستخدمه البوابة
Api__BaseUrl=http://127.0.0.1:5080

# عناوين الاستماع
ASPNETCORE_URLS=http://127.0.0.1:5080
