[Unit]
Description=ZU Training Platform API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
WorkingDirectory=/opt/zu-training/api
ExecStartPre=/usr/bin/dotnet /opt/zu-training/api/ZU.Training.WebApi.dll --migrate
ExecStart=/usr/bin/dotnet /opt/zu-training/api/ZU.Training.WebApi.dll
EnvironmentFile=/etc/zu-training/zu-training.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
User=zutraining
Group=zutraining
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=zu-training-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/zu-training/storage

[Install]
WantedBy=multi-user.target
